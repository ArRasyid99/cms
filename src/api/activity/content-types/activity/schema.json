{
  "kind": "collectionType",
  "collectionName": "activities",
  "info": {
    "singularName": "activity",
    "pluralName": "activities",
    "displayName": "Activity",
    "description": "Kegiatan dan program"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nama": {
      "type": "string",
      "required": true
    },
    "tanggal": {
      "type": "date",
      "required": true
    },
    "waktu": {
      "type": "string"
    },
    "penanggungJawab": {
      "type": "string"
    },
    "statusKegiatan": {
      "type": "enumeration",
      "default": "terjadwal",
      "enum": [
        "terjadwal",
        "berjalan",
        "selesai"
      ]
    },
    "judul": {
      "type": "string"
    },
    "tanggal_kajian": {
      "type": "date"
    }
  }
}
