HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=strapi_cms
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=ubah-password-ini
DATABASE_SSL=false
DATABASE_FILENAME=

# CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Isi true sekali untuk mengisi data awal (idempotent)
SEED_DATA=false

# Opsional: workaround @swc/core jika cache default ditolak (mis. ACL C:\ longgar).
# Buat folder khusus milik user Anda lebih dulu, lalu arahkan ke sana.
# SWC_NATIVE_BINDING_CACHE=D:\swc-cache
